[Unit]
Description=TransitTwin AI — Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/transittwin
ExecStart=/usr/bin/docker compose -f /opt/transittwin/docker-compose.prod.yml --env-file /opt/transittwin/.env.production up -d
ExecStop=/usr/bin/docker compose -f /opt/transittwin/docker-compose.prod.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
