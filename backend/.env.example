# PostgreSQL + PostGIS
DATABASE_URL=postgresql+asyncpg://transit:transit@localhost:5432/transitdb

# Redis
REDIS_URL=redis://localhost:6379

# Digitransit API key — register at https://portal.digitransit.fi
# Use the Primary key UUID shown under your subscription, not the plan name.
# Leave blank and set USE_MOCK_SEED=true if you're outside the EU.
DIGITRANSIT_API_KEY=your_key_here

# Set to true to skip Digitransit and seed from local fixture data instead.
# Useful when developing outside the EU where the API is geo-restricted.
USE_MOCK_SEED=false

# Groq API key — https://console.groq.com
GROQ_API_KEY=your_key_here
