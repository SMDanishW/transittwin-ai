# ============================================================
# TransitTwin AI — Production Environment Template
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
# These are used by the 'db' container and must match DATABASE_URL below.
POSTGRES_DB=transittwin
POSTGRES_USER=postgres
# CHANGE THIS — use a strong, unique password
POSTGRES_PASSWORD=change_me_strong_password

# ── Database connection (backend + worker) ───────────────────
# Must use the Docker service name 'db' as hostname.
# Password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+asyncpg://postgres:change_me_strong_password@db:5432/transittwin

# ── Redis ────────────────────────────────────────────────────
# Must use the Docker service name 'redis' as hostname.
REDIS_URL=redis://redis:6379

# ── API Keys ─────────────────────────────────────────────────
# REQUIRED: Get your key at https://console.groq.com
GROQ_API_KEY=change_me

# Optional: Digitransit API key for HSL data. Leave blank for public access.
# Register at https://digitransit.fi/en/developers/
DIGITRANSIT_API_KEY=

# ── App behaviour ────────────────────────────────────────────
# Set to false for live HSL GTFS-RT data (requires EU IP, e.g. eu-north-1).
# Set to true to seed from local fixture data (demo / non-EU testing).
USE_MOCK_SEED=false

GTFS_RT_BASE_URL=https://realtime.hsl.fi/realtime

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Replace with your actual domain (no trailing slash).
BACKEND_CORS_ORIGINS=https://your-domain.com,http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────
# Public URL of the backend as seen from the user's browser.
# Replace with your actual domain or EC2 public IP.
# Used as a build arg — baked into the Next.js bundle at build time.
NEXT_PUBLIC_API_URL=https://your-domain.com
